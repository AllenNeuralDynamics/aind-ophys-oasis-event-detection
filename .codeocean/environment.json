					"name": "git+https://github.com/AllenNeuralDynamics/aind-ophys-oasis-event-detection-library.git@5fb563a#egg=aind-ophys-oasis-event-detection-library"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
